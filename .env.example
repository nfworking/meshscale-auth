# Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# The platform is the only entry point. Visitors who reach the auth server directly are sent here.
PLATFORM_URL=http://localhost:3000

# Email (Resend). Leave RESEND_API_KEY empty in development to print codes in the server log instead.
RESEND_API_KEY=
EMAIL_FROM=Meshscale <onboarding@resend.dev>

# Social providers. A provider is shown on the sign-in page only when both values are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=

# Written by: pnpm db:seed
PLATFORM_CLIENT_ID=

# Passkeys are managed on the platform and used here, so the relying party id must cover both. Defaults to the host of BETTER_AUTH_URL.
# In production use the shared parent domain, e.g. meshscale.cloud
PASSKEY_RP_ID=
